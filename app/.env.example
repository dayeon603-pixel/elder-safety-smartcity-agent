# `make env` copies this to .env and fills KCF_SECRET_KEY with 32 random bytes (hex).
KCF_SECRET_KEY=
KCF_TOKEN_TTL_S=900
KCF_CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
# KCF_DB_PATH=backend/var/kcf.sqlite3
# KCF_DATA_DIR=../data/cache
FRONTEND_HOST_PORT=8190
# Optional hardening knobs (see backend/app/security/ALGORITHMS.md):
# KCF_AUDIT_KEY=            # separate HMAC key for the audit chain; default derived from KCF_SECRET_KEY
# KCF_ADMIN_EMAIL=          # registering this address yields an admin; prefer `make seed-admin EMAIL=...`
# KCF_ENV=dev               # serves /openapi.json; anything else (default) does not
# KCF_HSTS=true             # only once the site is really served over HTTPS
# KCF_TRUST_PROXY=true      # set by docker-compose; only when the backend is reachable solely via nginx
# Demo / agent infrastructure (backend/app/agent/README.md):
# KCF_DEMO_TOKEN=            # >= 16 chars; when set, /agent/* and /sim/* require header X-Demo-Token
# KCF_AGENT_SELF_URL=        # loopback only, e.g. http://127.0.0.1:8010; default = 127.0.0.1 + the bound port
# KCF_OLLAMA_URL=http://127.0.0.1:11434   # docker-compose sets http://host.docker.internal:11434
# KCF_AGENT_MODEL=qwen2.5:3b
# KCF_AGENT_VLM=qwen2.5vl:3b
# KCF_OLLAMA_KEEP_ALIVE=30m  # `make demo` default; 2m otherwise
# KCF_WARMUP=true            # preload the planner at startup (make demo sets it)
# KCF_REQUIRE_OLLAMA=false   # true: /health/deep and preflight fail when Ollama/model is missing
# KCF_AGENT_RUN_BUDGET_S=40  # per-run wall-clock budget for LLM calls; deterministic fallback after
# KCF_AGENT_MAX_CONCURRENT=3 # more simultaneous /agent/run -> 503 busy
# KCF_AGENT_RATE_CAPACITY=6 KCF_AGENT_RATE_REFILL_PER_S=0.5 KCF_SIM_RATE_CAPACITY=30 KCF_SIM_RATE_REFILL_PER_S=2
# KCF_MAX_SIM_BODY_BYTES=65536 KCF_MAX_AGENT_BODY_BYTES=6291456
# Outbound webhook for approved actions (both required together; local receiver double: POST /sim/webhook):
# KCF_WEBHOOK_URL=http://127.0.0.1:8010/sim/webhook
# KCF_WEBHOOK_SECRET=            # >= 16 chars; HMAC-SHA256 key for X-Zero-Point-Signature
# KCF_WEBHOOK_TIMEOUT_S=5 KCF_WEBHOOK_ATTEMPTS=3
# KCF_AUDIO_DIR=backend/var/audio  # cached 마을방송 WAV files (say -v Yuna + ffmpeg)
# 국립중앙의료원 E-Gen (data.go.kr B552657): the key itself, or `keychain` = read macOS keychain item DATA_GO_KR_KEY
# KCF_DATA_GO_KR_KEY=keychain
# KCF_MEDICAL_CACHE_DIR=backend/var/medical   KCF_MEDICAL_SNAPSHOT_DIR=../data/cache/extra/nmc_snapshots
# KCF_MEDICAL_DAILY_QUOTA=900
# KCF_ACTIONS_CACHE_DIR=backend/var/actions_cache  # pickled parsed source tables (행정동, 정류장, 횡단보도, AED)
