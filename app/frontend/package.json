{
  "name": "kcf-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "VITE_STATIC=1 VITE_DEMO_TOKEN= vite build --outDir dist-pages --emptyOutDir && node scripts/verify_pages.mjs dist-pages",
    "record:fixtures": "node scripts/record_fixtures.mjs",
    "preview:pages": "VITE_STATIC=1 vite preview --base /elder-safety-smartcity-agent/ --outDir dist-pages --port 5191",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --port 5190",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "playwright test --project=shots",
    "e2e:heat": "playwright test -c playwright.heat.config.ts",
    "shots:heat": "playwright test --project=shots heat.shots"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@luma.gl/gltf": "9.4.2",
    "@mediapipe/tasks-vision": "1.1.1",
    "earcut": "2.2.4",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@mapbox/vector-tile": "1.3.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/earcut": "2.1.4",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "pbf": "3.3.0",
    "pmtiles": "4.5.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
